// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  USER
  WORKER
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WorkerRequestStatus {
  PENDING
  REJECTED
  ACCEPTED
}

model Company {
  id            String    @id @default(nanoid())
  name          String
  typeOfCompany String
  location      String?
  feedback      String?
  createdAt     DateTime  @default(now())
  openTime      DateTime?
  closeTime     DateTime?
  image         String?

  workers      Worker[]
  applications WorkerApplication[]

  timeSchedules TimeSchedule[]
  users         User[]

  admin   Admin?  @relation(fields: [adminId], references: [id])
  adminId String?
}

model Worker {
  id          String   @id @default(nanoid())
  email       String   @unique
  clerkId     String?  @unique
  name        String
  phoneNumber String?
  experience  String
  feedback    String[]

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  applications  WorkerApplication[]
  timeSchedules TimeSchedule[]
}

model User {
  id        String   @id @default(nanoid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  clerkId   String   @unique
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Admin {
  id          String  @id @default(nanoid())
  name        String
  email       String  @unique
  phoneNumber String?

  companies Company[]
}

model TimeSchedule {
  id        String     @id @default(nanoid())
  day       Day
  startTime DateTime[]
  endTime   DateTime[]
  company   Company?   @relation(fields: [companyId], references: [id])
  companyId String?
  worker    Worker?    @relation(fields: [workerId], references: [id])
  workerId  String?
}

model WorkerApplication {
  id        String              @id @default(nanoid())
  workerId  String
  companyId String
  status    WorkerRequestStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  reason      String?
  decidedById String?

  worker  Worker  @relation(fields: [workerId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([workerId, companyId])
  @@index([companyId, status])
  @@index([workerId, status])
}
