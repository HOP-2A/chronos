// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  USER
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Company {
  id            String    @id @default(nanoid())
  name          String
  typeOfCompany String
  location      String?
  feedback      String?
  workers       Worker[]
  createdBy     Admin[]
  createdAt     DateTime  @default(now())
  openTime      DateTime?
  closeTime     DateTime?
  users         User[]

  timeSchedules TimeSchedule[]
}

model Worker {
  id            String         @id @default(nanoid())
  email         String         @unique
  name          String
  phoneNumber   String?
  experience    String[]
  feedback      String[]
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  timeSchedules TimeSchedule[]
}

model User {
  id        String   @id @default(nanoid())
  name      String
  email     String   @unique
  role      Role     @default(USER)
  clerkId   String   @unique
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Admin {
  id          String   @id @default(nanoid())
  name        String
  email       String   @unique
  phoneNumber String?
  companies   Company? @relation(fields: [companyId], references: [id])
  companyId   String?
}

model TimeSchedule {
  id        String   @id @default(nanoid())
  day       Day
  startTime DateTime
  endTime   DateTime
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id])
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
}
